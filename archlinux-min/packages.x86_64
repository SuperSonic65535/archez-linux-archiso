######## [ ESSENTIAL PACKAGES ] ########
## Keep pacman first, as other package install scripts rely on it.
pacman

## Linux kernel (required)
linux-zen

######## [ FIRMWARE AND DRIVERS ] ########
## Linux firmware - minimal configuration for most hardware
linux-firmware-amd
linux-firmware-atheros
linux-firmware-broadcom
linux-firmware-intel
linux-firmware-mediatek
linux-firmware-realtek

## CPU microcode (recommended - around 32MB)
amd-ucode
intel-ucode

######## [ NETWORKING ] ########
## Network manager (recommended)
networkmanager

## Wireless regulatory database (recommended)
wireless-regdb

######## [ CORE PACKAGES ] ########
## Arch Linux base (required)
base

## Bootloader
efibootmgr
grub
grub-auto-installer
os-prober

######## [ ARCHISO PACKAGES ] ########
## Mkinitcpio initramfs generator (required for ArchISO)
mkinitcpio
mkinitcpio-archiso

## Show progress during copy to RAM (optional)
pv

## Install scripts
archez-installer

######## [ UTILITY PACKAGES ] ########
## Text editor
nano

## Administration
sudo
