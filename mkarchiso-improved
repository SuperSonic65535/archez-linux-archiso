# Remove current boot mode from the bootmodes array
_remove_boot_mode() {
    local -i bootmodes_index

    for bootmodes_index in "${!bootmodes[@]}"; do
        if [[ "$bootmode" == "${bootmodes[${bootmodes_index}]}" ]]; then
            unset "bootmodes[${bootmodes_index}]"
            bootmodes=("${bootmodes[@]}")
            break
        fi
    done
}

