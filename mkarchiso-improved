            "$(printf '%0.1s' "#"{1..1024})")" \
        >"${isofs_dir}/boot/grub/grubenv"

    # Copy loopback.cfg to /boot/grub/ on ISO 9660
    if [[ -e "${profile}/grub/loopback.cfg" ]]; then
